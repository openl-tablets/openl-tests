{
  "realm": "openlstudio",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "groups": [
    { "name": "bypass-managers", "path": "/bypass-managers" },
    { "name": "grp-matched", "path": "/grp-matched" },
    { "name": "grp-ext-01", "path": "/grp-ext-01" },
    { "name": "grp-ext-02", "path": "/grp-ext-02" },
    { "name": "grp-ext-03", "path": "/grp-ext-03" },
    { "name": "grp-ext-04", "path": "/grp-ext-04" },
    { "name": "grp-ext-05", "path": "/grp-ext-05" },
    { "name": "grp-ext-06", "path": "/grp-ext-06" },
    { "name": "grp-ext-07", "path": "/grp-ext-07" },
    { "name": "grp-ext-08", "path": "/grp-ext-08" },
    { "name": "grp-ext-09", "path": "/grp-ext-09" },
    { "name": "grp-ext-10", "path": "/grp-ext-10" }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "OpenL",
      "lastName": "Admin",
      "email": "admin@openl.example",
      "credentials": [ { "type": "password", "value": "admin", "temporary": false } ]
    },
    {
      "username": "groupmgr",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Group",
      "lastName": "Manager",
      "email": "groupmgr@openl.example",
      "credentials": [ { "type": "password", "value": "groupmgr", "temporary": false } ],
      "groups": [ "/bypass-managers" ]
    },
    {
      "username": "studiouser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Studio",
      "lastName": "User",
      "email": "studiouser@openl.example",
      "credentials": [ { "type": "password", "value": "studiouser", "temporary": false } ]
    },
    {
      "username": "groupsuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Groups",
      "lastName": "User",
      "email": "groupsuser@openl.example",
      "credentials": [ { "type": "password", "value": "groupsuser", "temporary": false } ],
      "groups": [ "/grp-matched", "/grp-ext-01", "/grp-ext-02", "/grp-ext-03", "/grp-ext-04", "/grp-ext-05",
                  "/grp-ext-06", "/grp-ext-07", "/grp-ext-08", "/grp-ext-09", "/grp-ext-10" ]
    }
  ],
  "clients": [
    {
      "clientId": "openlstudio",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "openlstudiosecret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "*" ],
      "webOrigins": [ "*" ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "webstudio",
      "enabled": true,
      "protocol": "saml",
      "fullScopeAllowed": true,
      "standardFlowEnabled": true,
      "frontchannelLogout": true,
      "redirectUris": [ "*" ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml.force.post.binding": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_name_id_format": "username",
        "saml_force_name_id_format": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.name": "urn:oid:0.9.2342.19200300.100.1.3",
            "attribute.nameformat": "URI Reference"
          }
        },
        {
          "name": "firstName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "attribute.name": "urn:oid:2.5.4.42",
            "attribute.nameformat": "URI Reference"
          }
        },
        {
          "name": "lastName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "attribute.name": "urn:oid:2.5.4.4",
            "attribute.nameformat": "URI Reference"
          }
        },
        {
          "name": "displayName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "attribute.name": "urn:oid:2.16.840.1.113730.3.1.241",
            "attribute.nameformat": "URI Reference"
          }
        }
      ]
    }
  ]
}
